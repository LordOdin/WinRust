#include <windows.h>
#include <commctrl.h>

1 ICON "settings.ico"

101 DIALOGEX 0, 0, 374, 337
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "WinRust Settings"
FONT 10, "Segoe UI"
BEGIN
    LTEXT "Bar type", 1001, 12, 13, 39, 12
    COMBOBOX 110, 53, 10, 83, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Edge", 132, 146, 13, 27, 12
    COMBOBOX 131, 175, 10, 67, 90, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "Bar height", 1002, 252, 13, 54, 12
    COMBOBOX 111, 306, 10, 56, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "", 124, "SysTabControl32", WS_TABSTOP, 12, 34, 350, 20
    CONTROL "", 123, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 18, 55, 338, 151
    CONTROL "", 125, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | LVS_EDITLABELS | WS_BORDER | WS_TABSTOP | NOT WS_VISIBLE, 18, 55, 338, 151
    LTEXT "Palette", 127, 20, 62, 47, 12, NOT WS_VISIBLE
    COMBOBOX 128, 72, 59, 160, 100, CBS_DROPDOWNLIST | WS_TABSTOP | NOT WS_VISIBLE
    CONTROL "", 129, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP | NOT WS_VISIBLE, 18, 82, 338, 99
    PUSHBUTTON "Edit color...", 130, 18, 185, 85, 18, NOT WS_VISIBLE
    LTEXT "", 126, 20, 209, 334, 12
    LTEXT "Connected displays", 1004, 12, 229, 350, 12
    CONTROL "", 114, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 12, 243, 350, 57
    PUSHBUTTON "Tile windows", 115, 12, 309, 88, 18
    DEFPUSHBUTTON "Close", IDOK, 296, 309, 66, 18
END
