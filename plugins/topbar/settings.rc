#include <windows.h>
#include <commctrl.h>

101 DIALOGEX 0, 0, 374, 337
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "WinRust Settings"
FONT 10, "Segoe UI"
BEGIN
    LTEXT "Style", 1001, 12, 13, 36, 12
    COMBOBOX 110, 51, 10, 130, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Bar height", 1002, 200, 13, 69, 12
    COMBOBOX 111, 276, 10, 86, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Taskbar options", 1003, 12, 39, 350, 12
    CONTROL "", 123, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 12, 53, 350, 160
    LTEXT "Connected displays", 1004, 12, 222, 350, 12
    CONTROL "", 114, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 12, 236, 350, 64
    PUSHBUTTON "Tile windows", 115, 12, 309, 88, 18
    DEFPUSHBUTTON "Close", IDOK, 296, 309, 66, 18
END
