#include <windows.h>

101 DIALOGEX 0, 0, 442, 319
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "WinRust Settings"
FONT 10, "Segoe UI"
BEGIN
    GROUPBOX "Appearance", 1000, 10, 8, 205, 77
    LTEXT "Style", 1001, 20, 28, 56, 12
    COMBOBOX 110, 79, 25, 125, 85, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Bar height", 1002, 20, 55, 56, 12
    COMBOBOX 111, 79, 52, 125, 85, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX "Window behavior", 1003, 221, 8, 211, 77
    AUTOCHECKBOX "Hide the bar in fullscreen apps", 112, 231, 20, 194, 16, WS_TABSTOP
    AUTOCHECKBOX "Use all space on screens without the WinRust bar", 113, 231, 38, 194, 22, BS_MULTILINE | WS_TABSTOP
    AUTOCHECKBOX "Open previews on click instead of hover", 116, 231, 63, 194, 16, WS_TABSTOP
    GROUPBOX "App icons", 1005, 10, 92, 205, 91
    AUTOCHECKBOX "Hide Search icon", 119, 20, 109, 188, 16, WS_TABSTOP
    AUTOCHECKBOX "Hide Windows Start icon", 120, 20, 132, 188, 16, WS_TABSTOP
    AUTOCHECKBOX "Shuffle app icons each Windows boot", 118, 20, 155, 188, 19, BS_MULTILINE | WS_TABSTOP
    GROUPBOX "OLED protection", 1006, 221, 92, 211, 91
    AUTOCHECKBOX "Drift app icons up to 35 px left and right", 117, 231, 108, 194, 20, BS_MULTILINE | WS_TABSTOP
    AUTOCHECKBOX "Show right-side controls only on hover", 121, 231, 131, 194, 20, BS_MULTILINE | WS_TABSTOP
    AUTOCHECKBOX "Show settings gear only on hover", 122, 231, 154, 194, 20, BS_MULTILINE | WS_TABSTOP
    GROUPBOX "Connected displays", 1004, 10, 190, 422, 89
    EDITTEXT 114, 20, 207, 402, 61, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Tile windows", 115, 12, 290, 104, 18
    DEFPUSHBUTTON "Close", IDOK, 361, 290, 70, 18
END
