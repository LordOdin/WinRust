#include <windows.h>

101 DIALOGEX 0, 0, 346, 289
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "WinRust Settings"
FONT 10, "Segoe UI"
BEGIN
    GROUPBOX "Appearance", 1000, 10, 8, 326, 74
    LTEXT "Style", 1001, 20, 26, 85, 12
    COMBOBOX 110, 110, 23, 212, 85, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Bar height", 1002, 20, 51, 85, 12
    COMBOBOX 111, 110, 48, 212, 85, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX "Window behavior", 1003, 10, 88, 326, 58
    AUTOCHECKBOX "Hide the bar in fullscreen apps", 112, 20, 103, 306, 15, WS_TABSTOP
    AUTOCHECKBOX "Use all space on screens without the WinRust bar", 113, 20, 124, 306, 15, WS_TABSTOP
    GROUPBOX "Connected displays", 1004, 10, 152, 326, 97
    EDITTEXT 114, 20, 170, 306, 66, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Tile windows", 115, 12, 261, 104, 18
    DEFPUSHBUTTON "Close", IDOK, 265, 261, 70, 18
END
